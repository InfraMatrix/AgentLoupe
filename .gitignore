# AgentLoupe — Go + eBPF. All patterns are anchored to specific paths so
# they can never shadow source directories or go.mod/go.sum.

# Built binaries (make build / go build -o)
/agentloupe
/loupe-scorecard
/loupe-timeline

# Compiled BPF objects, generated next to their sources by `make bpf`
/bpf/*.o
/bpf/*.ll

# Local run output: JSONL event streams, loader logs, scratch configs.
# Any capture/report produced at the repo root is ignored, whatever
# the run was named — captures contain home paths and argv and must
# never be committed (make check enforces this for tracked files).
/tmp/
/*.jsonl
/timeline-*.html
/*-loader.log
/*-timeline.txt

# Go test / coverage artifacts produced at the repo root
/coverage.out
/coverage.html
/*.test

# Editor / OS noise at the repo root only
/.vscode/
/.idea/
