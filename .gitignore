# AgentLoupe — Go + eBPF. All patterns are anchored to specific paths so
# they can never shadow source directories or go.mod/go.sum.

# Built loader binary (make build)
/agentloupe

# Compiled BPF objects, generated next to their sources by `make bpf`
/bpf/*.o
/bpf/*.ll

# Local run output: JSONL event streams, loader logs, scratch configs.
/tmp/

# Go test / coverage artifacts produced at the repo root
/coverage.out
/coverage.html
/*.test

# Editor / OS noise at the repo root only
/.vscode/
/.idea/
