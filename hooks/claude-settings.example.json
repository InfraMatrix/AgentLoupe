{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 /path/to/AgentLoupe/hooks/agentloupe_hook.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 /path/to/AgentLoupe/hooks/agentloupe_hook.py" }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 /path/to/AgentLoupe/hooks/agentloupe_hook.py" }
        ]
      }
    ]
  }
}
